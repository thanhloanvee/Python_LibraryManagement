# ================================================================
# Environment configuration for Library Management System
# Copy this file to .env and fill in the values
# ================================================================

# Application
APP_NAME="Library Management System"
APP_VERSION="1.0.0"
DEBUG=true
ENVIRONMENT=development

# Security
SECRET_KEY=your-super-secret-key-change-in-production-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
DATABASE_URL=sqlite+aiosqlite:///./library.db

# Library Business Rules (mirrors PHP params.php)
BORROWING_PERIOD_DAYS=14
MAX_RENEWALS=2
FINE_PER_DAY=5000.0
MAX_ACTIVE_BORROWINGS=5

# Admin seed account
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=Admin@123456
ADMIN_FULL_NAME=System Administrator

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
